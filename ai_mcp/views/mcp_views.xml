<?xml version="1.0" encoding="utf-8"?>
<odoo>



    <!-- =================================================== Scopes ========== -->
    <record id="mcp_scope_view_list" model="ir.ui.view">
        <field name="name">mcp.scope.list</field>
        <field name="model">mcp.scope</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="line_count"/>
            </list>
        </field>
    </record>

    <record id="mcp_scope_view_form" model="ir.ui.view">
        <field name="name">mcp.scope.form</field>
        <field name="model">mcp.scope</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Read-only Sales"/></h1>
                    </div>
                    <div class="alert alert-info" role="alert">
                        This edition is <b>read-only</b>. An assistant governed by
                        this scope can search, count and aggregate the models
                        below and cannot create, update or delete anything.
                        Searches are capped at 200 rows and 500 calls per hour.
                    </div>
                    <field name="description" placeholder="What this scope is for…"/>
                    <notebook>
                        <page string="Model Access" name="lines">
                            <div class="alert alert-info" role="alert">
                                These switches can only ever <b>take access away</b>.
                                Every call runs as the signed-in Odoo user, so the
                                effective permission is whichever is narrower — this
                                matrix, or that user's own Odoo rights.
                            </div>
                            <button name="%(mcp_model_picker_action)d" type="action"
                                    string="Add Models" icon="fa-plus"
                                    class="btn-secondary mb-2"
                                    context="{'default_scope_id': id}"/>
                            <field name="line_ids"
                                   context="{'default_scope_id': id}">
                                <list editable="bottom" decoration-muted="not active">
                                    <field name="model_id"
                                           options="{'no_create': True}"/>
                                    <field name="can_read" widget="boolean_toggle"/>
                                    <field name="active" widget="boolean_toggle"
                                           optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Capabilities" name="capabilities">
                            <div class="alert alert-info" role="alert">
                                Leave empty to expose every installed capability.
                            </div>
                            <field name="capability_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mcp_scope_action" model="ir.actions.act_window">
        <field name="name">Scopes</field>
        <field name="res_model">mcp.scope</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ================================================= Audit Log ========= -->
    <record id="mcp_audit_view_list" model="ir.ui.view">
        <field name="name">mcp.audit.log.list</field>
        <field name="model">mcp.audit.log</field>
        <field name="arch" type="xml">
            <list decoration-danger="status == 'error'" create="false">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="tool"/>
                <field name="model_name"/>
                <field name="transport"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'ok'" decoration-danger="status == 'error'"/>
                <field name="duration_ms"/>
                <field name="tokens_est" sum="Total tokens"/>
                <field name="remote_addr" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="mcp_audit_view_search" model="ir.ui.view">
        <field name="name">mcp.audit.log.search</field>
        <field name="model">mcp.audit.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="tool"/>
                <field name="model_name"/>
                <filter name="errors" string="Errors" domain="[('status','=','error')]"/>
                <filter name="today" string="Today"
                        domain="[('create_date','>=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <!-- Bare <group>: the search-view RNG allows only colspan,
                     rowspan, fill, height, width, name, color, invisible,
                     position and groups here. 'expand' and 'string' are not
                     among them, and core's own search views carry neither. -->
                <group>
                    <filter name="g_user" string="User" context="{'group_by':'user_id'}"/>
                    <filter name="g_tool" string="Tool" context="{'group_by':'tool'}"/>
                    <filter name="g_model" string="Model" context="{'group_by':'model_name'}"/>
                    <filter name="g_status" string="Status" context="{'group_by':'status'}"/>
                </group>
            </search>
        </field>
    </record>



    <!-- Every user can see what their own assistant did. The record rule
         already allows this; without a menu the permission was unreachable. -->
    <record id="mcp_audit_own_action" model="ir.actions.act_window">
        <field name="name">My AI Activity</field>
        <field name="res_model">mcp.audit.log</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="mcp_audit_view_search"/>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing here yet</p>
            <p>
                Every action an AI assistant takes on your behalf is recorded
                here — which tool it used, on which model, when, and how long it
                took. Connect an assistant and come back.
            </p>
        </field>
    </record>



</odoo>
