<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ============================================ Groups ============= -->
        <record id="module_category_mcp" model="ir.module.category">
            <field name="name">AI MCP</field>
            <field name="description">AI / MCP connector governance.</field>
            <field name="sequence">80</field>
        </record>

        <!-- Odoo 19 moved the group<->category link behind res.groups.privilege:
             res.groups.category_id no longer exists, it is privilege_id, and the
             privilege carries the ir.module.category. Setting category_id on a
             group here fails the install outright. -->
        <record id="privilege_mcp" model="res.groups.privilege">
            <field name="name">AI MCP</field>
            <field name="category_id" ref="module_category_mcp"/>
            <field name="sequence">80</field>
            <field name="description">Who may connect an AI assistant, and who
                configures what those assistants are allowed to read.</field>
        </record>

        <record id="group_mcp_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="privilege_mcp"/>
            <field name="comment">Can connect their own AI assistant, see their
                own connections and read their own activity.</field>
        </record>

        <record id="group_mcp_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="privilege_mcp"/>
            <field name="implied_ids" eval="[(4, ref('group_mcp_user'))]"/>
            <field name="comment">Full configuration: the permission matrix,
                capabilities, tools, OAuth clients and the full activity log.</field>
        </record>

        <!-- Every Settings/System administrator administers this app too.
             Without this nobody holds group_mcp_user on a fresh install - Odoo
             never puts admin in a group a module invents - so the root menu,
             which is gated on it, is invisible and the whole app is
             unreachable despite installing cleanly. -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_mcp_admin'))]"/>
        </record>

        <!-- Every employee can connect their own assistant.

             This is navigation, not security. Three independent gates sit
             underneath it and none of them is this group: the scope is
             read-only, the permission matrix names the models one by one, and
             every call executes as the signed-in user, so ir.model.access and
             record rules apply on top. Without this line the app installs
             cleanly and is invisible to everyone except system administrators,
             and the thing the module exists to do - let a person ask their own
             Odoo a question - needs an admin to tick a box per person first. -->
        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_mcp_user'))]"/>
        </record>

        <!-- ======================================= Record Rules =========== -->
        <!-- OAuth connections: a user sees only their own; admins see all. -->
        <record id="rule_oauth_token_own" model="ir.rule">
            <field name="name">MCP connections: own only</field>
            <field name="model_id" ref="model_mcp_oauth_token"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_mcp_user'))]"/>
        </record>
        <record id="rule_oauth_token_admin" model="ir.rule">
            <field name="name">MCP connections: admin all</field>
            <field name="model_id" ref="model_mcp_oauth_token"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_mcp_admin'))]"/>
        </record>

        <!-- Activity log: own vs admin. -->
        <record id="rule_audit_own" model="ir.rule">
            <field name="name">MCP activity: own only</field>
            <field name="model_id" ref="model_mcp_audit_log"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_mcp_user'))]"/>
        </record>
        <record id="rule_audit_admin" model="ir.rule">
            <field name="name">MCP activity: admin all</field>
            <field name="model_id" ref="model_mcp_audit_log"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_mcp_admin'))]"/>
        </record>
    </data>
</odoo>
